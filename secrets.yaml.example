# Copy the entries you need into the secrets.yaml of your ESPHome config folder.
# Never commit your real secrets.yaml.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key. ESPHome generates one when you create a new device,
# or use: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_KEY"

ota_password: "choose-an-ota-password"

# Bluetooth MAC address of your Flex (find it with nRF Connect or a BLE scanner).
minidsp_flex_mac: "AA:BB:CC:DD:EE:FF"
